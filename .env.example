# Copy this file to .env.local and fill it in. Never commit .env.local.

# Tatum (dashboard.tatum.io → API keys). Used for Sui mainnet reads and the naira rate.
TATUM_API_KEY=

# Walrus Memory (memory.walrus.xyz/dashboard → your account → Delegate keys).
# MEMWAL_KEY is the delegate PRIVATE key. MEMWAL_ACCOUNT_ID is your account object ID.
MEMWAL_KEY=
MEMWAL_ACCOUNT_ID=

# Optional
# MEMWAL_RELAYER_URL=https://relayer.memory.walrus.xyz
# TATUM_SUI_GRAPHQL_URL=https://sui-mainnet.gateway.tatum.io/graphql
# Set to true on a public deployment so visitors can't write to your memory.
# TIDEOVER_READ_ONLY=true
